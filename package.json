{
  "name": "dzo",
  "version": "0.1.0",
  "description": "DZO — Decay · Zero · Open. The patient sniper terminal for pons v2 on Robinhood Chain. Local, open, non-custodial, dry run by default. Backtest, adaptive tax ceiling, cluster-fingerprinted farm detection.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dzo": "./bin/dzo.js"
  },
  "main": "./dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "prepare": "npm run build",
    "start": "tsx src/cli.ts",
    "hunt": "tsx src/cli.ts hunt",
    "board": "tsx src/cli.ts board",
    "doctor": "tsx src/cli.ts doctor",
    "replay": "tsx src/cli.ts replay",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').mkdirSync('dist/board',{recursive:true});require('fs').copyFileSync('src/board/index.html','dist/board/index.html')\"",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "viem": "^2.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "robinhood-chain",
    "pons",
    "sniper",
    "memecoin",
    "launchpad",
    "uniswap-v4",
    "viem",
    "trading-bot",
    "dzo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dezo/dzo"
  },
  "author": "Dezo <https://x.com/Dezo>"
}
