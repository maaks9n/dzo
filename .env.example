# DZO — .env.example
# copy to .env and edit. every value here is a default; delete a line to unset it.

# ── RPC ────────────────────────────────────────────────────────────────────────
# Public RPCs work out of the box. Set RPC_URL to a private provider to raise limits.
RPC_URL=
# comma-separated list of extra reader endpoints; DZO health-scores them and routes per method
RPC_URL_EXTRA=
# subscription endpoint. leave empty for publicnode default. set to `off` to poll instead.
RPC_WS_URL=
# gate tuning (defaults are conservative for the official public RPC)
RPC_IN_FLIGHT=3
RPC_SPACING_MS=50
RPC_LOGS_SPACING_MS=400
RPC_COOLDOWN_MS=1500

# ── Signer (only for --live, sell, wallet, claim) ─────────────────────────────
# use a fresh wallet holding only what you're willing to lose in one session.
# .env is git-ignored. never commit a real key.
PRIVATE_KEY=

# ── Sniper ────────────────────────────────────────────────────────────────────
SNIPE_ETH=0.01
SNIPE_MAX_TAX_BPS=300
SNIPE_BUDGET_ETH=0.05
SNIPE_MAX_OPEN=3
SNIPE_MIN_SCORE=60
# DZO addition: adaptive ceiling. `on` = use rolling EMA of successful entries, `off` = fixed SNIPE_MAX_TAX_BPS
SNIPE_ADAPTIVE_TAX=on

# ── Exits ─────────────────────────────────────────────────────────────────────
TAKE_PROFIT_PCT=80
STOP_LOSS_PCT=-35
TRAILING_PCT=25
MAX_HOLD_MIN=45

# ── Board ─────────────────────────────────────────────────────────────────────
BOARD_PORT=4663
BOARD_HOST=127.0.0.1

# ── Scoring config ────────────────────────────────────────────────────────────
# path to a YAML file with score weights. leave empty to use defaults from src/score.ts
SCORING_CONFIG=

# ── Alerts (optional) ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# `on` = accept two-way commands from the chat (close, pause, resume). needs TELEGRAM_CHAT_ID whitelist.
TELEGRAM_TWO_WAY=off
DISCORD_WEBHOOK_URL=

# ── Referrals (sign-up links printed under the wordmark; leave empty to hide) ──
REF_AXIOM=
REF_FOMO=
